{
  "name": "@chimichurria/audit",
  "version": "0.2.0",
  "description": "Auditoría y corrección de UI/UX multi-dispositivo, seguridad (OWASP, Vercel, Supabase, supply chain) y flujos UX por perfil. CLI + plugin de Claude Code + servidor MCP (Claude, Codex, Cursor y más).",
  "type": "module",
  "license": "MIT",
  "author": "ChimichurrIA",
  "repository": { "type": "git", "url": "git+https://github.com/chimichurria/audit.git" },
  "keywords": ["ui", "ux", "mobile", "audit", "playwright", "accessibility", "security", "owasp", "personas", "mcp", "claude-code", "codex", "cursor"],
  "engines": { "node": ">=20" },
  "bin": { "ui-audit": "cli/ui-audit.mjs" },
  "files": [
    "cli/", "lib/", "mcp/", "scripts/", "config/", "templates/", "skills/", "agents/", "commands/", "rules/", "hooks/",
    "adapters/", ".claude-plugin/", ".mcp.json", "AGENTS.md", "README.md", "LICENSE"
  ],
  "scripts": {
    "doctor": "node scripts/doctor.mjs",
    "doctor:security": "node scripts/doctor-security.mjs",
    "static": "node scripts/audit/static-scan.mjs",
    "audit": "node scripts/audit/run-audit.mjs",
    "diff": "node scripts/audit/diff-report.mjs",
    "security": "node scripts/security/run-security.mjs",
    "security:scan": "node scripts/security/security-scan.mjs",
    "security:headers": "node scripts/security/headers-check.mjs",
    "ux": "node scripts/ux/run-journeys.mjs",
    "ux:auth": "node scripts/ux/save-auth.mjs",
    "full": "node cli/ui-audit.mjs full",
    "mcp": "node mcp/server.mjs",
    "inspect": "npx -y @modelcontextprotocol/inspector node mcp/server.mjs",
    "test": "node --test --test-concurrency=1 \"tests/*.test.mjs\""
  },
  "dependencies": {
    "@axe-core/playwright": "^4.13.0",
    "@modelcontextprotocol/sdk": "^1.32.1",
    "playwright": "^1.64.0",
    "zod": "^4.6.5"
  }
}
